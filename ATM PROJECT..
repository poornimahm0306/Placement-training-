#include <stdio.h>
#include <stdlib.h>

// Structure to represent a user
typedef struct {
    int pin;
    float balance;
} User;

// Function to display the main menu
void displayMenu() {
    printf("1. Check Balance\n");
    printf("2. Withdraw Money\n");
    printf("3. Deposit Money\n");
    printf("4. Exit\n");
}

int main() {
    User user;
    user.pin = 1234;
    user.balance = 10000.0;

    int choice, pin;
    float amount;

    printf("Enter your PIN: ");
    scanf("%d", &pin);

    if (pin == user.pin) {
        while (1) {
            displayMenu();
            printf("Enter your choice: ");
            scanf("%d", &choice);

            switch (choice) {
                case 1:
                    printf("Your balance is: %.2f\n", user.balance);
                    break;
                case 2:
                    printf("Enter amount to withdraw: ");
                    scanf("%f", &amount);
                    if (amount > user.balance) {
                        printf("Insufficient balance!\n");
                    } else {
                        user.balance -= amount;
                        printf("Withdrawal successful. Remaining balance: %.2f\n", user.balance);
                    }
                    break;
                case 3:
                    printf("Enter amount to deposit: ");
                    scanf("%f", &amount);
                    user.balance += amount;
                    printf("Deposit successful. New balance: %.2f\n", user.balance);
                    break;
                case 4:
                    printf("Exiting...\n");
                    return 0;
                default:
                    printf("Invalid choice. Please try again.\n");
            }
        }
    } else {
        printf("Invalid PIN. Exiting...\n");
    }

    return 0;
}
