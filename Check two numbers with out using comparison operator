#include <stdio.h>
int areEqual(int a, int b) 
{
    return !(a - b);
}

int main() 
{
    int num1, num2;
    printf("Enter first number: ");
    scanf("%d", &num1);
    printf("Enter second number: ");
    scanf("%d", &num2);
    if (areEqual(num1, num2)) 
      {
        printf("%d and %d are equal.\n", num1, num2);
      }
      else 
      {
        printf("%d and %d are not equal.\n", num1, num2);
      }
    return 0;
}
